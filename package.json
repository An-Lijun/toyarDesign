{
  "name": "toyar-design",
  "description": "一个用于Vue3.x的ui组件库",
  "main": "./dist/index.js",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "/dist/*"
  ],
  "keywords": [
    "modules",
    "webUi",
    "toyar"
  ],
  "private": false,
  "version": "0.0.92-0",
  "scripts": {
    "dev": "vite",
    "build": "vite build -f es",
    "build:component": "node scripts/build-component.js",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docsBase",
    "docs:build": "vitepress build docsBase",
    "docs:build1": "node --max_old_space_size=8192 node_modules/vitepress/bin/vitepress.js build docsBase",
    "docs:serve": "vitepress serve docsBase",
    "pub": "npm version patch && npm run build && npm publish && exit 1",
    "pub2": "node ./src/shell/index.js",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss,json,md}\" \"scripts/**/*.{js,ts}\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,scss,json,md}\" \"scripts/**/*.{js,ts}\" \"*.{js,ts}\"",
    "generate:tokens": "node scripts/generate-tokens.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "robinson": "^1.0.22",
    "toyaricon": "^0.0.12",
    "vue": "^3.4.31",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-core": "^2.1.0",
    "@vue/test-utils": "^2.4.6",
    "@vuepress/plugin-register-components": "2.0.0-rc.15",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "20.0.0",
    "lint-staged": "^13.0.0",
    "markdown-it-container": "^3.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.87.0",
    "typescript": "^5.0.2",
    "unplugin-auto-import": "^0.12.0",
    "vite": "^6.3.3",
    "vite-plugin-chunk-split": "^0.5.0",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vitepress": "1.0.0-rc.20",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": "eslint --fix",
    "*.{js,mjs,cjs,ts,tsx,vue,scss,sass,css,json,jsonc,md}": "prettier --write"
  }
}
