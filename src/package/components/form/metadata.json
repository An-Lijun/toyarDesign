{
  "id": "form",
  "name": "TyForm",
  "category": "表单组件",
  "categoryKey": "form",
  "description": "表单组件，需配合 TyFormItem 使用。rules 字段支持 required、pattern、min、max、trigger 等校验规则。",
  "docPath": "docsBase/page/component/form/form.md",
  "props": {
    "customClass": {
      "type": "string | array | object",
      "default": "",
      "required": false,
      "description": "自定义类名，将追加到组件根节点"
    },
    "rules": {
      "type": "object",
      "default": null,
      "required": false,
      "description": "验证规则"
    },
    "labelWidth": {
      "type": "string",
      "default": "100",
      "required": false,
      "description": "标签宽度"
    },
    "labelSuffix": {
      "type": "string",
      "default": ":",
      "required": false,
      "description": "标签后缀"
    },
    "layout": {
      "type": "string",
      "default": "inline",
      "required": false,
      "description": "布局方式",
      "values": [
        "vertical",
        "inline"
      ]
    }
  },
  "emits": {},
  "slots": [
    "default"
  ],
  "examples": [
    {
      "title": "校验规则示例",
      "rules": {
        "username": [
          {
            "required": true,
            "message": "请输入用户名",
            "trigger": "blur"
          },
          {
            "min": 3,
            "max": 12,
            "message": "长度在 3 到 12 个字符",
            "trigger": "blur"
          }
        ],
        "email": [
          {
            "required": true,
            "message": "请输入邮箱",
            "trigger": "blur"
          },
          {
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "message": "邮箱格式不正确",
            "trigger": "blur"
          }
        ],
        "city": [
          {
            "required": true,
            "message": "请选择城市",
            "trigger": "change"
          }
        ]
      },
      "code": "<ty-form :model=\"form\" :rules=\"rules\">\n  <ty-form-item label=\"用户名\" prop=\"username\">\n    <ty-input v-model=\"form.username\" />\n  </ty-form-item>\n  <ty-form-item label=\"邮箱\" prop=\"email\">\n    <ty-input v-model=\"form.email\" />\n  </ty-form-item>\n  <ty-form-item label=\"城市\" prop=\"city\">\n    <ty-select v-model=\"form.city\">\n      <ty-select-option value=\"bj\" label=\"北京\" />\n      <ty-select-option value=\"sh\" label=\"上海\" />\n    </ty-select>\n  </ty-form-item>\n</ty-form>"
    }
  ],
  "capabilities": [],
  "useCases": [],
  "relatedComponents": [
    "TyFormItem"
  ]
}