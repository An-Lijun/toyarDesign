{
  "id": "button",
  "name": "TyButton",
  "category": "基础组件",
  "categoryKey": "base",
  "description": "Button 按钮（需配合 TyButtonGroup 使用）",
  "docPath": "docsBase/page/component/base/button.md",
  "props": {
    "customClass": {
      "type": "string | array | object",
      "default": "",
      "required": false,
      "description": "自定义类名，将追加到组件根节点"
    },
    "state": {
      "type": "string",
      "default": "primary",
      "required": false,
      "description": "按钮状态",
      "values": [
        "primary",
        "success",
        "warning",
        "danger"
      ]
    },
    "type": {
      "type": "string",
      "default": "normal",
      "required": false,
      "description": "按钮类型",
      "values": [
        "normal",
        "secondary",
        "outline",
        "dashed",
        "text",
        "link"
      ]
    },
    "block": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否为块级元素"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否禁用"
    },
    "size": {
      "type": "string",
      "default": "small",
      "required": false,
      "description": "按钮大小",
      "values": [
        "mini",
        "small",
        "medium",
        "large"
      ]
    },
    "html-type": {
      "type": "string",
      "default": "button",
      "required": false,
      "description": "html类型",
      "values": [
        "button",
        "submit",
        "reset"
      ]
    },
    "shape": {
      "type": "string",
      "default": "square",
      "required": false,
      "description": "按钮形状",
      "values": [
        "square",
        "round",
        "circle"
      ]
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否加载中"
    },
    "tag": {
      "type": "string",
      "default": "button",
      "required": false,
      "description": "自定义标签"
    }
  },
  "emits": {
    "click": {
      "params": [
        "event: MouseEvent"
      ],
      "description": "点击事件"
    }
  },
  "slots": [
    "loading",
    "default"
  ],
  "examples": [
    {
      "title": "基础用法示例",
      "code": "<ty-button state=\"primary\" @click=\"handleClick\">提交</ty-button>"
    }
  ],
  "capabilities": [],
  "useCases": [],
  "relatedComponents": [
    "TyButtonGroup"
  ]
}