  "docPath": "docsBase/page/component/show/carousel.md",
  "props": {
    "interval": {
      "type": "number",
      "default": 3000,
      "required": false,
      "description": "自动切换间隔时间（毫秒）"
    },
    "arrowMode": {
      "type": "string",
      "default": "hover",
      "required": false,
      "description": "箭头显示模式",
      "values": [
        "hover",
        "always",
        "never"
      ]
    },
    "easing": {
      "type": "string",
      "default": "ease",
      "required": false,
      "description": "过渡动画效果",
      "values": [
        "ease",
        "linear",
        "ease-in",
        "ease-out",
        "ease-in-out"
      ]
    },
    "isAutoPlay": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否自动播放"
    },
    "indicatorType": {
