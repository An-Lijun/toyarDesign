{
  "id": "select",
  "name": "TySelect",
  "category": "表单组件",
  "categoryKey": "form",
  "description": "选择器组件，需配合 TySelectOption 使用，支持通过 TySelectGroup 对选项进行分组。",
  "docPath": "docsBase/page/component/form/select.md",
  "props": {
    "size": {
      "type": "string",
      "default": "small",
      "required": false,
      "description": "选择器尺寸"
    },
    "multiple": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否多选"
    },
    "clearable": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否可清空"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否禁用"
    },
    "readonly": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否只读"
    },
    "modelValue": {
      "type": "string | number | array",
      "default": null,
      "required": true,
      "description": "当前选中值（v-model绑定）"
    },
    "placeholder": {
      "type": "string",
      "default": "",
      "required": false,
      "description": "占位文本"
    },
    "icon": {
      "type": "string",
      "default": "ty-arrow-down-s-line",
      "required": false,
      "description": "图标"
    },
    "width": {
      "type": "string",
      "default": "100%",
      "required": false,
      "description": "宽度"
    }
  },
  "emits": {
    "blur": {
      "params": [],
      "description": ""
    },
    "input": {
      "params": [],
      "description": ""
    },
    "update:modelValue": {
      "params": [],
      "description": ""
    }
  },
  "slots": [
    "default"
  ],
  "examples": [
    {
      "title": "基础用法示例",
      "code": "<ty-select v-model=\"value\" placeholder=\"请选择\">\n  <ty-select-group label=\"一线城市\">\n    <ty-select-option value=\"bj\" label=\"北京\" />\n    <ty-select-option value=\"sh\" label=\"上海\" />\n  </ty-select-group>\n  <ty-select-option value=\"hz\" label=\"杭州\" />\n</ty-select>"
    }
  ],
