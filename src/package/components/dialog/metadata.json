{
  "id": "dialog",
  "name": "TyDialog",
  "category": "反馈组件",
  "categoryKey": "feedback",
  "description": "dialog",
  "docPath": "docsBase/page/component/feedback/dialog.md",
  "props": {
    "customClass": {
      "type": "string | array | object",
      "default": "",
      "required": false,
      "description": "自定义类名，将追加到组件根节点"
    },
    "title": {
      "type": "string",
      "default": "提示",
      "required": false,
      "description": "对话框标题"
    },
    "width": {
      "type": "string",
      "default": "30%",
      "required": false,
      "description": "对话框宽度 支持百分比和calc计算宽度"
    },
    "top": {
      "type": "string",
      "default": "15vh",
      "required": false,
      "description": "对话框距顶部距离"
    },
    "content": {
      "type": "string",
      "default": null,
      "required": false,
      "description": "提示信息"
    },
    "isUnderLine": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否显示下划线"
    },
    "isTeleport": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否使用 teleport 传送"
    },
    "draggable": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否可拖拽"
    },
    "mask": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否显示遮罩层"
    },
    "maskClosable": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否允许点击遮罩层关闭对话框"
    },
    "isScrollLock": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "弹窗打开时是否锁定 body 滚动"
    },
    "destroyOnClose": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "关闭时是否销毁弹窗内容"
    },
    "closeOnEsc": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否允许按 ESC 键关闭对话框"
    },
    "isShowClose": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否展示关闭按钮"
    },
    "fullscreen": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "是否开启全屏"
    },
    "beforeClose": {
      "type": "function",
      "default": null,
      "required": false,
      "description": "关闭前的回调，调用 done 才会真正关闭 Dialog"
    }
  },
  "emits": {
    "modelValue": {
      "params": [
        "_value: boolean"
      ],
      "description": ""
    }
  },
  "slots": [
    "title",
    "default",
    "footer"
  ],
  "examples": [],
  "capabilities": [],
  "useCases": []
}